  "RecommendedExclude": ["node_modules", ".venv", "venv", "__pycache__", ".pytest_cache", ".next", ".turbo", ".pnpm-store", ".mypy_cache", ".ruff_cache", "pytest-of-*"],
  "DefaultMode": "Mirror",
  "Choices": [
    {"Path": "Projects", "Mode": "Both", "Reason": "Source, local changes, Git history, assets and data"},
    {"Path": "Tools", "Mode": "Both", "Reason": "Custom scripts, configuration and offline tools"}
  ]
