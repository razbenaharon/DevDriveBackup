{
  "Source": "X:\\",
  "SourceVolumeId": "REPLACE_WITH_GET_VOLUME_UNIQUEID",
  "DestinationVolumeId": "REPLACE_WITH_DESTINATION_VOLUME_UNIQUEID",
  "RepositoryFolder": "DevDrive-Backup",
  "PasswordDpapiPath": "C:\\Users\\YOUR_USER\\AppData\\Local\\DevDriveMirror\\repository-password.dpapi",
  "RecoveryKeyPath": "C:\\Users\\YOUR_USER\\Backup Center recovery keys\\recovery-key.txt",
  "Profile": "Balanced",
  "RateMBps": 45,
  "MemoryMiB": 1024,
  "CpuThreads": 2,
  "ReadConcurrency": 2,
  "PackMiB": 16,
  "Include": ["Projects", "Tools"],
